<HostServicesScreen>:
    name: "host_services_screen"
    BoxLayout:
        orientation: "vertical"
        md_bg_color: 1, 1, 1, 1

        # ==========================================
        # 1. محتوای اصلی (لیست خدمات)
        # ==========================================
        MDFloatLayout:
            md_bg_color: 1, 1, 1, 1
            
            # عنوان صفحه
            MDLabel:
                text: app.fa("خدمات ثبت شده شما")
                pos_hint: {"center_x": .5, "center_y": .90}
                halign: "center"
                font_name: "Vazirmatn.ttf"
                font_size: "10sp"

            # لیست خدمات
            ScrollView:
                pos_hint: {"center_x": .5, "center_y": .45}
                size_hint: .95, .75
                MDList:
                    id: host_services_list

